generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  invoices Invoice[]
}

model Invoice {
  id          Int      @id @default(autoincrement())
  clientId    Int
  amount      Float
  description String
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])
}
